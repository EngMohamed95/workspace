# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==================== MySQL Database Configuration ====================
# Set MYSQL_HOST (and credentials) to connect Stack Space to your MySQL 8 / MariaDB server.
# If MYSQL_HOST is left empty, the server automatically uses a local SQLite database for quick preview.
DB_DRIVER="mysql"
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="stack_space"
MYSQL_SSL="false"

# Optional fallback local SQLite path when MYSQL_HOST is empty
DB_PATH="data/stackspace.db"

# Optional server-side passcode override for the default 'admin' account.
# Leave empty to use the one-time first-run admin setup screen inside the app.
ADMIN_PASSCODE=

# Root password for the local Docker MySQL (docker-compose.yml). Not used by the app itself.
MYSQL_ROOT_PASSWORD=
